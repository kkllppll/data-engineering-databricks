{
  "datasets": [
    {
      "name": "77280ab6",
      "displayName": "sales_daily",
      "queryLines": [
        "SELECT\n",
        "  d.full_date        AS order_date,\n",
        "  c.country_code     AS country,\n",
        "  a.category,\n",
        "  a.items_count,\n",
        "  a.quantity,\n",
        "  a.gross_amount_usd,\n",
        "  a.discount_amount_usd,\n",
        "  a.net_amount_usd\n",
        "FROM agg_daily_sales a\n",
        "JOIN dim_date    d ON a.date_key    = d.date_key\n",
        "JOIN dim_country c ON a.country_key = c.country_key"
      ]
    },
    {
      "name": "bcf2a65a",
      "displayName": "order_lines",
      "queryLines": [
        "SELECT\n",
        "  f.order_id,\n",
        "  d.full_date        AS order_date,\n",
        "  c.country_code     AS country,\n",
        "  p.category,\n",
        "  ch.payment_method,\n",
        "  ch.device,\n",
        "  f.quantity,\n",
        "  f.net_amount_usd\n",
        "FROM fact_order_items f\n",
        "JOIN dim_date          d  ON f.date_key          = d.date_key\n",
        "JOIN dim_product       p  ON f.product_id        = p.product_id\n",
        "JOIN dim_country       c  ON f.country_key       = c.country_key\n",
        "JOIN dim_order_channel ch ON f.order_channel_key = ch.order_channel_key"
      ],
      "columns": [
        {
          "displayName": "avg_order_value",
          "description": "",
          "expression": "  SUM(net_amount_usd) / COUNT(DISTINCT order_id)"
        }
      ]
    }
  ],
